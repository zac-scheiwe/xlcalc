"name": "Orders",
"range": "Data!A1:G21"
},
{
"op": "set",
"cell": "Data!G2",
"input": "=[@Qty]*[@Unit]*(1-[@Disc])"
},
{
"op": "table_totals",
"sheet": "Data",
"name": "Orders",
"value": true
},
{
"op": "set",
"cell": "Data!G22",
"input": "=SUBTOTAL(109,[Net])"
},
{
"op": "set",
"cell": "Data!D22",
"input": "=SUBTOTAL(103,[Qty])"
},
{
"op": "set",
"cell": "Data!E22",
"input": "=SUBTOTAL(101,[Unit])"
},
{
"op": "set",
"cell": "Rep!D1",
"input": "=SUMIFS(Orders[Net],Orders[Region],B1,Orders[Product],B2,Orders[Qty],B4)"
},
{
"op": "set",
"cell": "Rep!D2",
"input": "=COUNTIFS(Orders[Region],B1,Orders[Product],B2)"
},
{
"op": "set",
"cell": "Rep!D3",
"input": "=SUM(Orders[[#Totals],[Net]])"
},
{
"op": "set",
"cell": "Rep!D4",
"input": "=Orders[[#Headers],[Net]]"
},
{
"op": "set",
"cell": "Rep!D5",
"input": "=ROWS(Orders[#Data])&\"x\"&COLUMNS(Orders)"
},
{
"op": "set",
"cell": "Rep!D6",
"input": "=SUM(Orders[[Qty]:[Net]])"
},
{
"op": "set",
"cell": "Rep!D7",
"input": "=SUMPRODUCT((Orders[Region]=B1)*Orders[Qty]*Orders[Unit])"
},
{
"op": "set",
"cell": "Rep!D8",
"input": "=INDEX(Orders[Order],MATCH(MAX(Orders[Net]),Orders[Net],0))"
},
{
"op": "set",
"cell": "Rep!D9",
"input": "=LARGE(Orders[Net],B3)"
},
{
"op": "set",
"cell": "Rep!D10",
"input": "=SUMIFS(Orders[Net],Orders[Net],\">=\"&LARGE(Orders[Net],B3))"
},
{
"op": "set",
"cell": "Rep!F1",
"input": "=LET(n,B3,d,Orders[[Order]:[Net]],s,SORTBY(d,INDEX(d,,6),-1),TAKE(s,n))"
},
{
"op": "set",
"cell": "Rep!F8",
"input": "=LET(r,UNIQUE(Orders[Region]),t,SUMIFS(Orders[Net],Orders[Region],r),k,SORTBY(HSTACK(r,t,t/SUM(t)),t,-1),k)"
},
{
"op": "set",
"cell": "Rep!F14",
"input": "=LET(f,FILTER(Orders,(Orders[Region]=B1)*(Orders[Qty]>=10),\"none\"),IFERROR(ROWS(f),0)&\" rows, avg \"&TEXT(AVERAGE(INDEX(f,,6)),\"0.00\"))"
},
{
"op": "set",
"cell": "Rep!F15",
"input": "=XLOOKUP(1,(Orders[Region]=B1)*(Orders[Product]=\"Gizmo\"),Orders[Net],\"n/a\",0,-1)"
},
{
"op": "set",
"cell": "Rep!F16",
"input": "=XMATCH(B1,Orders[Region],0,-1)"
},
{
"op": "set",
"cell": "Rep!F17",
"input": "=SUMPRODUCT(LARGE(Orders[Net],{1,2,3}))"
},
{
"op": "set",
"cell": "Rep!F18",
"input": "=RANK.EQ(INDEX(Orders[Net],2),Orders[Net])&\"/\"&COUNT(Orders[Net])"
},
{
