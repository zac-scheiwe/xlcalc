{"sheets": ["Sheet1", "Sheet2"], "steps": [{"op": "set", "cell": "Sheet1!A1", "input": "1"}, {"op": "set", "cell": "Sheet1!A2", "input": "2"}, {"op": "set", "cell": "Sheet1!A3", "input": "3"}, {"op": "set", "cell": "Sheet1!A4", "input": "4"}, {"op": "set", "cell": "Sheet2!A1", "input": "10"}, {"op": "set", "cell": "Sheet2!A2", "input": "20"}, {"op": "name", "name": "inc", "refers_to": "=LAMBDA(x,x+1)"}, {"op": "name", "name": "addn", "refers_to": "=LAMBDA(x,[y],x+IF(ISOMITTED(y),100,y))"}, {"op": "name", "name": "fib", "refers_to": "=LAMBDA(n,IF(n<2,n,fib(n-1)+fib(n-2)))"}, {"op": "name", "name": "tri", "refers_to": "=LAMBDA(n,SUM(SEQUENCE(n)))"}, {"op": "name", "name": "rng", "refers_to": "=Sheet1!$A$1:$A$4"}, {"op": "name", "name": "arr", "refers_to": "={1,2;3,4}"}, {"op": "name", "name": "dbl", "refers_to": "=Sheet1!$A$1:$A$4*2"}, {"op": "name", "name": "seq", "refers_to": "=SEQUENCE(3)"}, {"op": "name", "name": "tot", "refers_to": "=SUM(Sheet1!$A$1:$A$4)"}, {"op": "name", "name": "rel", "refers_to": "=Sheet1!A1"}, {"op": "name", "name": "relcol", "refers_to": "=Sheet1!$A1:$A2"}, {"op": "name", "name": "rng", "refers_to": "=Sheet2!$A$1:$A$2", "scope": "Sheet2"}, {"op": "name", "name": "mapper", "refers_to": "=LAMBDA(a,MAP(a,LAMBDA(z,z*z)))"}, {"op": "name", "name": "lt", "refers_to": "=LET(q,5,q*2)"}, {"op": "set", "cell": "Sheet1!C1", "input": "=inc(5)"}, {"op": "set", "cell": "Sheet1!C2", "input": "=MAP(rng,inc)"}, {"op": "set", "cell": "Sheet1!C3", "input": "=addn(1)"}, {"op": "set", "cell": "Sheet1!C4", "input": "=addn(1,2)"}, {"op": "set", "cell": "Sheet1!C5", "input": "=tri(4)"}, {"op": "set", "cell": "Sheet1!C6", "input": "=MAP(SEQUENCE(4),tri)"}, {"op": "set", "cell": "Sheet1!C7", "input": "=SUM(rng)"}, {"op": "set", "cell": "Sheet1!C8", "input": "=arr"}, {"op": "set", "cell": "Sheet1!C10", "input": "=arr*2"}, {"op": "set", "cell": "Sheet1!C12", "input": "=dbl"}, {"op": "set", "cell": "Sheet1!C17", "input": "=seq"}, {"op": "set", "cell": "Sheet1!C20", "in