{
  "sheets": ["Sheet1", "Sheet2", "Sheet3"],
  "steps": [
    {"cell": "Sheet1!H1", "input": "1", "op": "set"},
    {"cell": "Sheet1!H2", "input": "2", "op": "set"},
    {"cell": "Sheet1!H3", "input": "3", "op": "set"},
