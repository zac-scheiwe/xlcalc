    {"cell": "'Sheet2 (2)'!A1", "input": "100", "op": "set"},
    {"op": "read", "range": "'Sheet2 (2)'!A1:C12"},
    {"after": "Sheet3", "op": "move_sheet", "sheet": "Sheet1"},
    {"op": "names"},
    {"name": "Cpy", "op": "rename_sheet", "sheet": "Sheet2 (2)"},
