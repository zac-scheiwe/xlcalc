    {"name": "Nc", "op": "name", "refers_to": "=SUM(Ka)", "scope": "Sheet2"},
    {"name": "Nd", "op": "name", "refers_to": "=SUM(Kf)", "scope": "Sheet2"},
    {"name": "Ne", "op": "name", "refers_to": "=Kg", "scope": "Sheet2"},
    {"name": "Nf", "op": "name", "refers_to": "=Kh", "scope": "Sheet2"},
    {"name": "Ng", "op": "name", "refers_to": "=Ki", "scope": "Sheet2"},
    {"name": "Nh", "op": "name", "refers_to": "=Kt", "scope": "Sheet2"},
    {"name": "Ni", "op": "name", "refers_to": "=Ku", "scope": "Sheet2"},
    {"name": "Nj", "op": "name", "refers_to": "=Kv", "scope": "Sheet2"},
    {"name": "Nk", "op": "name", "refers_to": "=Na+1", "scope": "Sheet2"},
    {"name": "Nl", "op": "name", "refers_to": "=Kc+Kf", "scope": "Sheet2"},
    {"cell": "Sheet2!C1", "input": "=Na", "op": "set"},
    {"cell": "Sheet2!C2", "input": "=Nb", "op": "set"},
    {"cell": "Sheet2!C3", "input": "=Nc", "op": "set"},
