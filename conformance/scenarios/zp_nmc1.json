    {"cell": "Sheet2!C10", "input": "=Nj", "op": "set"},
    {"cell": "Sheet2!C11", "input": "=Nk", "op": "set"},
    {"cell": "Sheet2!C12", "input": "=SUM(Nl)", "op": "set"},
    {"op": "names"},
    {"after": "Sheet3", "op": "copy_sheet", "sheet": "Sheet2"},
