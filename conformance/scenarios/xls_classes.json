  {
   "op": "om_put",
   "path": "ActiveWorkbook.Worksheets('Sheet1').Range('C8')",
   "prop": "Formula",
   "value": "=GESTEP(A3,A2)+PERMUT(A4,A2)+EFFECT(A2,A4)"
  },
  {
   "op": "om_put",
   "path": "ActiveWorkbook.Worksheets('Sheet1').Range('C9')",
   "prop": "Formula",
   "value": "=start+SUM(trio)+MIN(start/250,ABS(-A2))"
  },
