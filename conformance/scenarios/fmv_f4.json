{
  "sheets": ["Sheet1", "Sheet2"],
  "check_all_formats": true,
  "check_empty_formats": true,
  "steps": [
    {"op": "format", "range": "Sheet1!A1", "fmt": "d-mmm-yy"},
    {"op": "set", "cell": "Sheet1!A1", "input": "45678"},
    {"op": "format", "range": "Sheet1!B1", "fmt": "$#,##0.00"},
    {"op": "set", "cell": "Sheet1!B1", "input": "12.5"},
    {"op": "format", "range": "Sheet1!C1", "fmt": "0.00%"},
    {"op": "set", "cell": "Sheet1!C1", "input": "0.25"},
    {"op": "format", "range": "Sheet1!D1", "fmt": "h:mm"},
    {"op": "set", "cell": "Sheet1!D1", "input": "0.5"},
    {"op": "format", "range": "Sheet1!E1", "fmt": "0\"E\""},
    {"op": "set", "cell": "Sheet1!E1", "input": "3"},
    {"op": "format", "range": "Sheet1!F1", "fmt": "0\"F\""},
    {"op": "set", "cell": "Sheet1!F1", "input": "4"},
    {"op": "set", "cell": "Sheet1!G1", "input": "5"},
    {"op": "format", "range": "Sheet1!H1", "fmt": "0.00E+00"},
    {"op": "set", "cell": "Sheet1!H1", "input": "1234.5"},
    {"op": "format", "range": "Sheet1!I1", "fmt": "# ?/?"},
    {"op": "set", "cell": "Sheet1!I1", "input": "0.5"},
    {"op": "set", "cell": "Sheet1!J3", "input": "=(E1*F1)+B1"},
    {"op": "set", "cell": "Sheet1!J4", "input": "=B1+E1*F1"},
    {"op": "set", "cell": "Sheet1!J5", "input": "=ABS(E1)+B1"},
    {"op": "set", "cell": "Sheet1!J6", "input": "=B1+ABS(E1)"},
    {"op": "set", "cell": "Sheet1!J7", "input": "=IF(TRUE,E1,F1)+B1"},
    {"op": "set", "cell": "Sheet1!J8", "input": "=SUM(ABS(E1),B1)"},
    {"op": "set", "cell": "Sheet1!J9", "input": "=MAX(ABS(E1),B1)"},
    {"op": "set", "cell": "Sheet1!J10", "input": "=MAX(B1,ABS(E1))"},
    {"op": "set", "cell": "Sheet1!J11", "input": "=B1%+C1"},
    {"op": "set", "cell": "Sheet1!J12", "input": "=C1+B1%"},
    {"op": "set", "cell": "Sheet1!J13", "input": "=(A1+A1)+B1"},
    {"op": "set", "cell": "Sheet1!J14", "input": "=B1+(A1+A1)"},
    {"op": "set", "cell": "Sheet1!J15", "input": "=SUM(A1,A1,B1)"},
    {"op": "set", "cell": "Sheet1!J16", "input": "=SUM(B1,A1,A1,C1)"},
    {"op": "set", "cell": "Sheet1!J17", "input": "=B1+C1+A1"},
    {"op": "set", "cell": "Sheet1!J18", "input": "=A1+B1+A1"},
    {"op": "set", "cell": "Sheet1!J19", "input": "=ROUND(E1*F1,0)+B1"},
    {"op": "set", "cell": "Sheet1!J20", "input": "=PRODUCT(E1)+B1"},
    {"op": "set", "cell": "Sheet1!J21", "input": "=E1/F1+B1"},
    {"op": "set", "cell": "Sheet1!J22", "input": "=E1^2+B1"},
    {"op": "set", "cell": "Sheet1!J23", "input": "=(E1&\"\")+B1"},
    {"op": "set", "cell": "Sheet1!J24", "input": "=INT(ABS(B1))+C1"},
    {"op": "set", "cell": "Sheet1!J25", "input": "=SUM(PRODUCT(E1,F1),B1)"},
    {"op": "set", "cell": "Sheet1!J26", "input": "=LARGE(E1:F1,1)+B1"},
    {"op": "set", "cell": "Sheet1!J27", "input": "=INDEX(E1:F1,1)+B1"},
    {"op": "set", "cell": "Sheet1!J28", "input": "=-(A1+A1)"},
    {"op": "set", "cell": "Sheet1!J29", "input": "=-(A1+A1)+B1"},
    {"op": "set", "cell": "Sheet1!J30", "input": "=SUM(-(A1+A1),B1)"},
    {"op": "set", "cell": "Sheet1!J31", "input": "=A1-A1+B1"},
    {"op": "set", "cell": "Sheet1!J32", "input": "=B1+(A1-A1)"},
    {"op": "set", "cell": "Sheet1!J33", "input": "=B1+DATE(2024,1,1)"},
    {"op": "set", "cell": "Sheet1!J34", "input": "=TIME(1,1,1)*2+B1"},
    {"op": "set", "cell": "Sheet1!J35", "input": "=NPV(0.1,B1)+A1"},
    {"op": "set", "cell": "Sheet1!J36", "input": "=A1+NPV(0.1,B1)"},
    {"op": "set", "cell": "Sheet1!J37", "input": "=A1+PMT(0.1,1,1)"},
    {"op": "set", "cell": "Sheet1!J38", "input": "=D1+D1+A1"},
    {"op": "set", "cell": "Sheet1!J39", "input": "=D1-D1+A1"},
    {"op": "read", "range": "Sheet1!J3:J39"}
  ]
}
