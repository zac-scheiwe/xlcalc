{
"op": "table",
"name": "tSales",
"range": "Sales!A1:G17"
},
{
"op": "set",
"cell": "Sales!G2",
"input": "=[@Units]*[@Price]"
},
{
"op": "set",
"cell": "Dash!A4",
"input": "=LET(t,tSales,r,B1,f,IF(r=\"All\",t,FILTER(t,tSales[Region]=r)),SUM(INDEX(f,,7)))"
},
{
"op": "set",
"cell": "Dash!A5",
"input": "=UNIQUE(tSales[Region])"
},
{
"op": "set",
"cell": "Dash!B5",
"input": "=SUMIFS(tSales[Total],tSales[Region],A5#)"
},
{
"op": "set",
"cell": "Dash!C5",
"input": "=XLOOKUP(A5#,tSales[Region],tSales[Rep])"
},
{
"op": "set",
"cell": "Dash!D5",
"input": "=COUNTIFS(tSales[Region],A5#,tSales[Units],\">=\"&B2)"
},
{
"op": "set",
"cell": "Dash!F1",
"input": "=TAKE(SORTBY(tSales[[Rep]:[Total]],tSales[Total],-1),5)"
},
{
"op": "set",
"cell": "Dash!F8",
"input": "=LET(u,UNIQUE(tSales[Rep]),s,SUMIFS(tSales[Total],tSales[Rep],u),TAKE(SORTBY(HSTACK(u,s),s,-1),3))"
},
{
"op": "set",
"cell": "Dash!K1",
"input": "=GROUPBY(tSales[Region],tSales[Total],SUM)"
},
{
"op": "set",
"cell": "Dash!K8",
"input": "=PIVOTBY(tSales[Region],tSales[Product],tSales[Units],SUM)"
},
{
"op": "set",
"cell": "Dash!A12",
"input": "=TEXTJOIN(\", \",TRUE,UNIQUE(FILTER(tSales[Product],tSales[Total]>200)))"
},
{
"op": "set",
"cell": "Dash!A13",
"input": "=SUM(tSales[Total])"
},
{
"op": "set",
"cell": "Dash!A14",
"input": "=AVERAGEIFS(tSales[Price],tSales[Product],\"Widget\")"
},
{
"op": "set",
"cell": "Dash!A15",
"input": "=MAXIFS(tSales[Total],tSales[Region],\"East\")"
},
{
"op": "set",
"cell": "Dash!A16",
"input": "=XLOOKUP(MAX(tSales[Total]),tSales[Total],tSales[Date])"
},
{
"op": "set",
"cell": "Dash!A17",
"input": "=TEXT(A16,\"dd mmm yyyy\")"
},
{
"op": "set",
"cell": "Dash!A18",
"input": "=ROWS(FILTER(tSales,tSales[Units]>=B2))"
},
{
"op": "set",
"cell": "Dash!A19",
"input": "=SORT(UNIQUE(tSales[Product]))"
},
{
"op": "set",
"cell": "Dash!B19",
"input": "=MAP(A19#,LAMBDA(p,SUM(FILTER(tSales[Total],tSales[Product]=p))))"
},
{
"op": "set",
"cell": "Dash!C19",
"input": "=SCAN(0,B19#,LAMBDA(a,b,a+b))"
},
{
"op": "set",
"cell": "Dash!D19",
"input": "=BYROW(tSales[[Units]:[Price]],LAMBDA(r,PRODUCT(r)))"
},
