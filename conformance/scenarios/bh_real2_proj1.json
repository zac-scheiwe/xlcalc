{
"op": "table",
"name": "tPlan",
"range": "Plan!A1:F9"
},
{
"op": "set",
"cell": "Plan!F2",
"input": "=WORKDAY.INTL([@Start],[@Days]-1,$I$2,$I$3:$I$4)"
},
{
"op": "set",
"cell": "Plan!G1",
"input": "Status"
},
{
"op": "set",
"cell": "Plan!G2",
"input": "=IF([@Pct]=1,\"Done\",IF($I$1>[@Done],\"Late\",IF($I$1>=[@Start],\"In progress\",\"Not started\")))"
},
{
"op": "set",
"cell": "Plan!H6",
"input": "=NETWORKDAYS.INTL(MIN(tPlan[Start]),MAX(tPlan[Done]),$I$2,$I$3:$I$4)"
},
{
"op": "set",
"cell": "Plan!H7",
"input": "=SUMPRODUCT(tPlan[Days]*tPlan[Pct])/SUM(tPlan[Days])"
},
{
"op": "set",
"cell": "Plan!H8",
"input": "=COUNTIF(tPlan[Status],\"Late\")&\" late of \"&ROWS(tPlan)"
},
{
"op": "set",
"cell": "Plan!H9",
"input": "=TEXT(MAX(tPlan[Done]),\"ddd d mmm yyyy\")"
},
{
"op": "set",
"cell": "Plan!H10",
"input": "=NETWORKDAYS.INTL($I$1,MAX(tPlan[Done]),\"0000011\")"
},
{
"op": "set",
"cell": "Plan!H11",
"input": "=DAYS(MAX(tPlan[Done]),MIN(tPlan[Start]))&\" days / \"&DATEDIF(MIN(tPlan[Start]),MAX(tPlan[Done]),\"m\")&\" m\""
},
{
"op": "set",
"cell": "Plan!H12",
"input": "=XLOOKUP(\"Late\",tPlan[Status],tPlan[Task],\"none\")"
},
{
"op": "set",
"cell": "Plan!H13",
"input": "=TEXTJOIN(\", \",TRUE,FILTER(tPlan[Task],tPlan[Status]<>\"Done\",\"-\"))"
},
{
"op": "set",
"cell": "Plan!H14",
"input": "=WEEKNUM(MIN(tPlan[Start]),2)&\"/\"&ISOWEEKNUM(MAX(tPlan[Done]))"
},
{
"op": "set",
"cell": "Plan!H15",
"input": "=EOMONTH(MAX(tPlan[Done]),0)-MAX(tPlan[Done])"
},
{
"op": "set",
"cell": "Plan!H16",
"input": "=WORKDAY(MAX(tPlan[Done]),-5)"
},
{
"op": "set",
"cell": "Gantt!A1",
"input": "Task"
},
{
"op": "set",
"cell": "Gantt!A2",
"input": "=tPlan[Task]"
},
{
"op": "set",
"cell": "Gantt!B1",
"input": "=SEQUENCE(1,20,MIN(tPlan[Start]),1)"
},
{
"op": "set",
"cell": "Gantt!B2",
"input": "=IF((B$1>=tPlan[Start])*(B$1<=tPlan[Done])*(WEEKDAY(B$1,2)<6),\"#\",\"\")"
},
{
"op": "set",
"cell": "Gantt!B12",
"input": "=BYROW(B2#,LAMBDA(r,COUNTIF(r,\"#\")))"
},
{
"op": "set",
"cell": "Gantt!C12",
"input": "=MAP(tPlan[Start],tPlan[Done],LAMBDA(a,b,NETWORKDAYS(a,b)))"
},
{
"op": "set",
"cell": "Gantt!D12",
"input": "=TEXT(B1#,\"d/m\")"
},
{
"op": "set",
"cell": "Gantt!B25",
"input": "=TOROW(IF(B2#=\"#\",B1#,NA()),3)"
},
