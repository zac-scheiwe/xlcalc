{"sheets": ["Sheet1", "Sheet2"], "steps": [{"op": "name", "name": "Oa", "refers_to": "=LAMBDA([a],[b],IF(ISOMITTED(a),10,a)+IF(ISOMITTED(b),20,b))"}, {"op": "set", "cell": "Sheet1!A1", "input": "=Oa()"}, {"op": "set", "cell": "Sheet1!A2", "input": "=Oa(1)"}, {"op": "set", "cell": "Sheet1!A3", "input": "=Oa(,2)"}, {"op": "set", "cell": "Sheet1!A4", "input": "=Oa(1,2)"}, {"op": "name", "name": "Ob", "refers_to": "=LAMBDA([a],b,a+b)"}, {"op": "name", "name": "Oc", "refers_to": "=LAMBDA(a,[b],[c],IF(ISOMITTED(c),a,a+c))"}, {"op": "set", "cell": "Sheet1!B1", "input": "=Oc(1)"}, {"op": "set", "cell": "Sheet1!B2", "input": "=Oc(1,2,3)"}, {"op": "set", "cell": "Sheet1!B3", "input": "=Oc(1,,3)"}, {"op": "set", "cell": "Sheet1!B4", "input": "=Oc(1,2,)"}, {"op": "set", "cell": "Sheet1!C1", "input": "=BYROW({1,2;3,4},Oc)"}, {"op": "set", "cell": "Sheet1!C3", "input": "=REDUCE(0,{1;2;3},Oc)"}, {"op": "set", "cell": "Sheet1!C4", "input": "=REDUCE(0,{1;2;3},LAMBDA(a,b,[c],a+b))"}, {"op": "set", "cell": "Sheet1!D1", "input": "=LET(f,LAMBDA(x,[y],x+IF(ISOMITTED(y),100,y)),f(1)+f(1,2))"}, {"op": "set", "cell": "Sheet1!D2", "input": "=LAMBDA([x],ISOMITTED(x))()"}, {"op": "set", "cell": "Sheet1!D3", "input": "=LAMBDA([x],IF(ISOMITTED(x),\"o\",x))(5)"}, {"op": "set", "cell": "Sheet1!D4", "input": "=LAMBDA(x,[x],x)(1)"}, {"op": "set", "cell": "Sheet1!E1", "input": "=LAMBDA(x,[y],y)(1)"}, {"op": "set", "cell": "Sheet1!E2", "input": "=LAMBDA(x,[y],IF(ISOMITTED(y),0,y)+x)(1,)"}, {"op": "set", "cell": "Sheet1!E3", "input": "=LAMBDA([ x ],x)(1)"}, {"op": "names"}, {"op": "read", "range": "Sheet1!A1:E10"}, {"op": "read_text", "range": "Sheet1!A1:E10"}]}