{"sheets": ["Sheet1", "Sheet2"], "steps": [{"op": "set", "cell": "Sheet1!A1", "input": "Name"}, {"op": "set", "cell": "Sheet1!B1", "input": "Qty"}, {"op": "set", "cell": "Sheet1!C1", "input": "Price"}, {"op": "set", "cell": "Sheet1!D1", "input": "Total"}, {"op": "set", "cell": "Sheet1!A2", "input": "x"}, {"op": "set", "cell": "Sheet1!B2", "input": "3"}, {"op": "set", "cell": "Sheet1!C2", "input": "2.5"}, {"op": "set", "cell": "Sheet1!A3", "input": "y"}, {"op": "set", "cell": "Sheet1!B3", "input": "5"}, {"op": "set", "cell": "Sheet1!C3", "input": "1.1"}, {"op": "set", "cell": "Sheet1!A4", "input": "z"}, {"op": "set", "cell": "Sheet1!B4", "input": "2"}, {"op": "set", "cell": "Sheet1!C4", "input": "10"}, {"op": "set", "cell": "Sheet1!A5", "input": "x"}, {"op": "set", "cell": "Sheet1!B5", "input": "7"}, {"op": "set", "cell": "Sheet1!C5", "input": "0.3"}, {"op": "table", "name": "Tb", "range": "Sheet1!A1:D5"}, {"op": "set", "cell": "Sheet1!D2", "input": "=[@Qty]*[@Price]"}, {"op": "set", "cell": "Sheet1!D3", "input": "=Tb[@Qty]*Tb[@Price]"}, {"op": "set", "cell": "Sheet1!D4", "input": "=LET(q,[@Qty],p,[@Price],q*p)"}, {"op": "set", "cell": "Sheet1!D5", "input": "=SUM(Tb[@[Qty]:[Price]])"}, {"op": "set", "cell": "Sheet1!F1", "input": "=SORT(Tb,3,-1)"}, {"op": "set", "cell": "Sheet1!K1", "input": "=FILTER(Tb[[Name]:[Price]],Tb[Qty]>2)"}, {"op": "set", "cell": "Sheet1!O1", "input": "=SUMPRODUCT(Tb[Qty],Tb[Price])"}, {"op": "set", "cell": "Sheet1!O2", "input": "=BYROW(Tb[[Qty]:[Price]],LAMBDA(r,PRODUCT(r)))"}, {"op": "set", "cell": "Sheet1!P2", "input": "=UNIQUE(Tb[Name])"}, {"op": "set", "cell": "Sheet1!Q1", "input": "=SUM(Tb[Total])"}, {"op": "set", "cell": "Sheet1!Q2", "input": "=SUMIFS(Tb[Total],Tb[Name],P2#)"}, {"op": "set", "cell": "Sheet1!R1", "input": "=XLOOKUP(P2#,Tb[Name],Tb[Qty])"}, {"op": "set", "cell": "Sheet1!R5", "input": "=ROWS(Tb[#Data])"}, {"op": "set", "cell": "Sheet1!R6", "input": "=INDEX(Tb[Price],MATCH(MAX(Tb[Qty]),Tb[Qty],0))"}, {"op": "set", "cell": "